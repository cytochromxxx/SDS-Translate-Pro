                </GeneralInformation>
                <GeneralInformation PhraseId="9267225027" PhraseCatalogueId="0">
                    <FullText>If unconscious but breathing normally, place in recovery position and seek medical advice.</FullText>
                </GeneralInformation>
                <GeneralInformation PhraseId="9267225014" PhraseCatalogueId="0">
                    <FullText>Do not leave affected person unattended.</FullText>
                </GeneralInformation>
                <FirstAidInhalation PhraseId="9267225039" PhraseCatalogueId="0">
                    <FullText>Provide fresh air.</FullText>
                </FirstAidInhalation>
                <FirstAidInhalation PhraseId="9267225037" PhraseCatalogueId="0">
                    <FullText>In case of respiratory tract irritation, consult a physician.</FullText>
                </FirstAidInhalation>
                <FirstAidInhalation PhraseId="9267225032" PhraseCatalogueId="0">
                    <FullText>If breathing is irregular or stopped, administer artificial respiration.</FullText>
                </FirstAidInhalation>
                <FirstAidInhalation PhraseId="9267225030" PhraseCatalogueId="0">
                    <FullText>No mouth-to-mouth or mouth-to-nose resuscitation. Use Ambu bag or ventilator.</FullText>
                </FirstAidInhalation>
                <FirstAidInhalation PhraseId="9294221815" PhraseCatalogueId="0">
                    <FullText>Get immediate medical advice/attention.</FullText>
                </FirstAidInhalation>
                <FirstAidInhalation PhraseId="9294221814" PhraseCatalogueId="0">
