        <FirstAidMeasures>
            <DescriptionOfFirstAidMeasures>
                <GeneralInformation PhraseId="9267225017" PhraseCatalogueId="0">
                    <FullText>In case of accident or unwellness, seek medical advice immediately (show directions for use or safety data sheet if possible).</FullText>
